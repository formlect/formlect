{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --filter api test)",
      "Bash(pnpm --filter api check)",
      "Bash(pnpm --filter api exec tsc --noEmit)",
      "Bash(pnpm --filter web exec tsc --noEmit)",
      "Bash(pnpm --filter web lint)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.production)",
      "Write(**/.env)",
      "Write(**/.env.local)",
      "Write(**/.env.production)"
    ]
  }
}
