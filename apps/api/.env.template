NODE_ENV="development"   # development | production | test
PORT="8080"
HOST="localhost"
TRUST_PROXY="0"          # number of reverse proxies in front of the app (e.g. 1 on most PaaS)

# Comma-separated origins allowed by CORS / Better Auth
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

COMMON_RATE_LIMIT_WINDOW_MS="1000"
COMMON_RATE_LIMIT_MAX_REQUESTS="30"

DATABASE_URL=""

# Public URL of the web app
WEB_URL="http://localhost:3000"

# Resend (https://resend.com). Required in production; in dev, links are logged if empty.
# Use a sender on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=""
EMAIL_FROM="Formlect <onboarding@resend.dev>"

# Better Auth (BETTER_AUTH_SECRET: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:8080"
GOOGLE_ID=""
GOOGLE_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8080/api/auth/callback/google"
GITHUB_ID=""
GITHUB_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:8080/api/auth/callback/github"

